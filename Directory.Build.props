<Project>

  <!-- The one place the version lives. The release workflow refuses a tag that does not match it. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>LocalExpense</Product>
    <Authors>AhmdSkr</Authors>
    <Copyright>Public domain (The Unlicense)</Copyright>
    <RepositoryUrl>https://github.com/AhmdSkr/LocalExpense</RepositoryUrl>
  </PropertyGroup>

  <!-- Debug symbols inside each dll, so a single-file release still reports line numbers and no loose .pdb has to ship. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
