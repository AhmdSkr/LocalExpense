<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LocalExpense</RootNamespace>
    <!-- The exe people download is LocalExpense.exe. Resource names follow RootNamespace, so they do not change with it. -->
    <AssemblyName>LocalExpense</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ScottPlot.WinForms depends on OpenTK, OpenTK.GLControl and SkiaSharp.Views.WindowsForms, which only ship .NET Framework assets. NuGet warns about
         that (NU1701) for each of them; they load and draw correctly on net10.0-windows, so the warning is silenced for this project only. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalExpense.Core\LocalExpense.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- ApplicationIcon only covers the exe in Explorer and the taskbar; the windows load their icon from here (FormHelpers.AppIcon). -->
    <EmbeddedResource Include="app.ico" LogicalName="LocalExpense.app.ico" />
    <!-- The demo window's data (see Program.LoadSampleData), inside the exe so the Sample data button works wherever the exe is copied. -->
    <EmbeddedResource Include="..\..\samples\lebanon-family-expenses.csv" LogicalName="LocalExpense.SampleData.csv" Link="samples\lebanon-family-expenses.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

</Project>
